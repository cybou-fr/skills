{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CYBOU Risk Matrix",
  "type": "object",
  "required": [
    "version",
    "risk_levels",
    "scoring"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "risk_levels": {
      "type": "object"
    },
    "scoring": {
      "type": "object"
    },
    "critical_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
