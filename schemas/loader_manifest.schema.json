{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cybou.fr/schemas/loader_manifest.schema.json",
  "title": "Cybou Loader Manifest",
  "type": "object",
  "required": [
    "version",
    "loader_contract",
    "required_files",
    "canonical_dirs",
    "validation"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "loader_contract": {
      "type": "string"
    },
    "required_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "canonical_dirs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation": {
      "type": "object"
    }
  }
}
