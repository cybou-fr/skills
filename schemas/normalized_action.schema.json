{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CYBOU Normalized Action",
  "type": "object",
  "required": [
    "tool",
    "operation",
    "raw_input"
  ],
  "properties": {
    "tool": {
      "type": "string"
    },
    "operation": {
      "type": "string"
    },
    "raw_input": {
      "type": "string"
    },
    "args": {
      "type": "object"
    },
    "target": {
      "type": "string"
    },
    "environment": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "side_effects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sensitive_data_possible": {
      "type": "boolean"
    }
  }
}
