{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cybou.fr/schemas/command_pattern_mapping.schema.json",
  "title": "Cybou Command Pattern Mapping",
  "type": "object",
  "required": [
    "version",
    "patterns",
    "matching_policy"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "regex",
          "verdict",
          "risk",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "regex": {
            "type": "string"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "Allow",
              "Deny",
              "NeedsApproval"
            ]
          },
          "risk": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "matching_policy": {
      "type": "object"
    }
  }
}
