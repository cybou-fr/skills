{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CYBOU Agent Skill Test Scenarios",
  "type": "object",
  "required": [
    "version",
    "scenarios"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "input",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "input": {
            "type": "string"
          },
          "expected": {
            "type": "object"
          }
        }
      }
    }
  }
}
