{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CYBOU Tool Policy",
  "type": "object",
  "required": [
    "tool",
    "version",
    "rules"
  ],
  "properties": {
    "tool": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "default": {
      "type": "string"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "match_regex",
          "decision",
          "risk"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "match_regex": {
            "type": "string"
          },
          "decision": {
            "type": "string"
          },
          "risk": {
            "type": "string"
          }
        }
      }
    }
  }
}
