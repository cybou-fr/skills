{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cybou.fr/schemas/operational_contract_v1.schema.json",
  "title": "Cybou Skill Operational Contract v1",
  "type": "object",
  "required": [
    "name",
    "version",
    "skill_format",
    "category",
    "default_mode",
    "default_risk",
    "requires_tools",
    "policy_refs",
    "output_template"
  ],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "version": {"const": "7.0"},
    "skill_format": {"const": "operational_contract_v1"},
    "category": {"type": "string", "minLength": 1},
    "default_mode": {"enum": ["read_only", "review_only", "guarded", "blocked"]},
    "default_risk": {"enum": ["low", "medium", "high", "critical"]},
    "requires_tools": {
      "type": "object",
      "required": ["preferred", "fallback"],
      "properties": {
        "preferred": {"type": "array", "items": {"type": "string"}},
        "fallback": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "policy_refs": {"type": "array", "items": {"type": "string"}},
    "output_template": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
