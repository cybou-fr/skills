{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cybou.fr/schemas/policy_rule.schema.json",
  "title": "Cybou Policy Rule File",
  "type": "object",
  "required": [
    "version",
    "rules"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "decision"
        ],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "decision": {
            "type": "string"
          },
          "risk": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "match": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          },
          "redaction_required": {
            "type": "boolean"
          },
          "approval_required": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
