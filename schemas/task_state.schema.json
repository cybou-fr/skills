{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CYBOU Task State",
  "type": "object",
  "required": [
    "task_id",
    "status",
    "selected_skills",
    "risk"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "received",
        "classified",
        "waiting_for_approval",
        "executing",
        "blocked",
        "completed",
        "failed"
      ]
    },
    "selected_skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "environment": {
      "type": "string"
    },
    "profile": {
      "type": "string"
    },
    "scope_id": {
      "type": "string"
    },
    "approval_id": {
      "type": "string"
    }
  }
}
