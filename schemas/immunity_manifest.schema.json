{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cybou.fr/schemas/immunity_manifest.schema.json",
  "title": "Cybou Immunity Manifest",
  "type": "object",
  "required": [
    "version",
    "role",
    "target_modules",
    "files",
    "runtime_verdicts"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "target_modules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "files": {
      "type": "object"
    },
    "runtime_verdicts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
