{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CYBOU Pentest Severity Model",
  "type": "object",
  "required": [
    "version",
    "scale",
    "factors",
    "severity_floor"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "scale": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "factors": {
      "type": "object"
    },
    "severity_floor": {
      "type": "object"
    },
    "output_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
