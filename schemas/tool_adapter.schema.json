{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CYBOU Tool Adapter",
  "type": "object",
  "required": [
    "tool",
    "version",
    "adapter_type",
    "decision_inputs"
  ],
  "properties": {
    "tool": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "adapter_type": {
      "type": "string"
    },
    "decision_inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "enforcement": {
      "type": "object"
    },
    "allowed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_read_only": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approval_required": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "denied": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "denied_by_default": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
