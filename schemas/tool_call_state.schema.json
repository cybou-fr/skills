{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CYBOU Tool Call State",
  "type": "object",
  "required": [
    "tool_call_id",
    "tool",
    "status",
    "policy_decision"
  ],
  "properties": {
    "tool_call_id": {
      "type": "string"
    },
    "tool": {
      "type": "string"
    },
    "status": {
      "enum": [
        "proposed",
        "allowed",
        "blocked",
        "executed",
        "failed"
      ]
    },
    "policy_decision": {
      "type": "object"
    },
    "redaction_applied": {
      "type": "boolean"
    },
    "audit_event_id": {
      "type": "string"
    }
  }
}
