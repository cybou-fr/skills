{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cybou.fr/schemas/registry.schema.json",
  "title": "Cybou Skills Registry",
  "type": "object",
  "required": [
    "version",
    "skills"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "path",
          "category",
          "default_risk",
          "default_mode"
        ],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "path": {
            "type": "string",
            "pattern": "^(core|devops|secops|productivity)/.*/SKILL\\.md$"
          },
          "category": {
            "type": "string",
            "enum": [
              "core",
              "devops",
              "secops",
              "productivity"
            ]
          },
          "triggers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "default_risk": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "default_mode": {
            "type": "string"
          },
          "requires_tools": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "input_types": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "output_template": {
            "type": "string"
          },
          "related_skills": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "do_not_use_for": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "autonomy_level": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          }
        }
      }
    }
  }
}
