{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cybou.fr/schemas/sensitive_targets.schema.json",
  "title": "Cybou Sensitive Targets",
  "type": "object",
  "required": [
    "version",
    "targets"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "pattern",
          "risk",
          "verdict"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "pattern": {
            "type": "string"
          },
          "risk": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "verdict": {
            "type": "string",
            "enum": [
              "Allow",
              "Deny",
              "NeedsApproval"
            ]
          },
          "when": {
            "type": "string"
          }
        }
      }
    }
  }
}
